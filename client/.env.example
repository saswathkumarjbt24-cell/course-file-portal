# Base URL of the Express API.
#
# SET   -> every screen loads from MySQL through client/src/data/api.js
# UNSET -> every screen falls back to client/src/data/mockData.js and makes
#          no network request at all
#
# Copy this file to .env to enable API mode. Comment the line out (or delete
# .env) to go back to the mock fixtures.
VITE_API_URL=http://localhost:5001

# Show the faculty picker on the sign-in page.
#
# The picker is NOT authentication: it signs you in as any listed member of
# staff with no password. It exists so the portal can be demonstrated before
# institutional Google sign-in is configured.
#
# MUST BE false (or removed entirely) IN PRODUCTION.
#
# Only the exact string 'true' enables it. Vite inlines the value at build
# time, so this is decided when the bundle is built, not at runtime - a
# production build simply does not contain the picker.
VITE_ALLOW_DEMO_LOGIN=true

# Google OAuth client id. Public by design - it identifies the app to Google
# and is embedded in the browser bundle. It is NOT a secret.
#
# MUST match GOOGLE_CLIENT_ID in server/.env: the server verifies that the ID
# token was issued for that exact client id, so a mismatch fails every
# sign-in. Leave it unset and the Google button is not rendered at all.
#
# Google sign-in also needs VITE_API_URL, because the token is verified on the
# server. A build without VITE_API_URL runs on mock fixtures and cannot use it.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
