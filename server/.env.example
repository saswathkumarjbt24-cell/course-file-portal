# ---------------------------------------------------------------
# server/.env template
#
# Copy to server/.env and fill in. server/.env is gitignored; this file is
# not, so the set of keys the server needs stays visible in the repository
# without any value ever being committed.
# ---------------------------------------------------------------

# --- Database -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=course_file_portal

# --- Google sign-in -------------------------------------------------
# The OAuth client id issued by Google for this app. Public by design: it
# identifies the app and is embedded in the browser bundle, so it is NOT a
# secret. The server needs it as the audience an ID token must be issued for
# -- a token minted for a different client id is rejected.
#
# The frontend reads the same value from client/.env as VITE_GOOGLE_CLIENT_ID.
# The two MUST match, or every sign-in fails verification.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only accounts in this domain may sign in.
#
# Checked on the SERVER against the verified `email` claim of the ID token,
# comparing the part after the last '@' case-insensitively. The `hd` claim and
# the `hd` parameter the frontend passes to Google are hints for the account
# chooser only and are never trusted here.
ALLOWED_EMAIL_DOMAIN=bitsathy.ac.in

# --- Session tokens -------------------------------------------------
# The HMAC key the API signs and verifies its OWN session tokens with, after
# Google has verified who you are. Nothing to do with Google; it never leaves
# the server.
#
# THIS ONE IS A REAL SECRET, unlike GOOGLE_CLIENT_ID above. Anyone holding it
# can mint a token for any account, including an admin, without ever touching
# Google. It must not be committed, shared, logged, or reused between the
# staging and production servers.
#
# Generate a fresh one per install:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The server refuses to start without it -- a missing key would otherwise mean
# either unsigned tokens or a per-restart key that logs everybody out.
# Changing it invalidates every issued token immediately, which is the way to
# force the whole institution to sign in again.
JWT_SECRET=generate-me-see-the-command-above
